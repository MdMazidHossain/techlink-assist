# TECHLINK ASSIST ENVIRONMENT VARIABLES

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase / Database Integration (Self-hosted or Supabase Cloud)
# When provided, Techlink Assist syncs live with your PostgreSQL Supabase instance.
# When left blank, the platform utilizes its built-in reactive local database.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-side Service Role (Backend only - NEVER expose in client bundles)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Notification Email (Destination for incoming service and product requests)
# VITE_ADMIN_NOTIFICATION_EMAIL="contact@techlinkassist.com"
